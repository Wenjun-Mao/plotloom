# Plotloom server configuration.
# Copy to `.env` in this repository root. Host environment variables take
# precedence. Never commit a real API key.

# Provider credentials. Type-specific keys override the AtlasCloud fallback.
ATLASCLOUD_API_KEY=
TEXT_MODEL_API_KEY=
# Named text profiles use this pattern. It takes precedence over the legacy
# TEXT_MODEL_API_KEY for that profile; never put browser-session keys here.
# PLOTLOOM_PROFILE_LOCAL_LLAMA_TEXT_API_KEY=
IMAGE_MODEL_API_KEY=
VIDEO_MODEL_API_KEY=

# Trusted provider profiles. HTTP and HTTPS API roots are supported for a
# server-managed loopback, LAN, or Tailnet provider. Do not put URL credentials
# here; redirects are never followed.
TEXT_PROVIDER=
TEXT_BASE_URL=
# Use the exact public ID returned by the provider's /models endpoint. Plotloom
# freezes this value and does not silently replace it with the first model.
TEXT_MODEL=
TEXT_AUTH_MODE=bearer
TEXT_SUPPORTS_JSON_OBJECT=false
TEXT_SUPPORTS_JSON_SCHEMA=false
TEXT_SUPPORTS_CHAT_TEMPLATE_KWARGS=false
TEXT_CONTEXT_WINDOW_TOKENS=32768
TEXT_MAX_OUTPUT_TOKENS=8192
TEXT_TEMPERATURE=0.2
TEXT_MAX_CONCURRENCY=1
TEXT_CONNECT_TIMEOUT_SECONDS=10
TEXT_ATTEMPT_TIMEOUT_SECONDS=300
# V2 execution contract used only when `default` is first materialized. Once
# saved, profiles are complete snapshots and later `.env` edits do not mutate
# them. Set TEXT_PRESET_ID=custom whenever any published preset value differs.
TEXT_PRESET_ID=compatible_v1
TEXT_REQUEST_EXTENSION=none
TEXT_REASONING_MODE=provider_default
TEXT_EXTRACTION_ALLOW_JSON_FENCE=false
TEXT_EXTRACTION_ALLOW_LEADING_THINK_BLOCK=false
TEXT_STORY_BIBLE_MAX_OUTPUT_TOKENS=8192
TEXT_STORY_GRAPH_MAX_OUTPUT_TOKENS=8192
TEXT_SCENE_BEATS_MAX_OUTPUT_TOKENS=4096
TEXT_STORYBOARD_MAX_OUTPUT_TOKENS=4096
TEXT_MAX_SEMANTIC_CORRECTIONS=2
IMAGE_PROVIDER=
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_AUTH_MODE=bearer
VIDEO_PROVIDER=
VIDEO_BASE_URL=
VIDEO_MODEL=
VIDEO_AUTH_MODE=bearer

# Private Spark MiniMax-H3 uses its typed Tailnet gateway, not ComfyUI
# directly. The gateway bearer key is the server-only VIDEO_MODEL_API_KEY.
# Use the catalog trust anchor below; do not put a URL credential or public
# endpoint here. The workbench selects only reviewed frozen H3 profiles. H3
# does not draw down the Wan pilot ledger.
# Deployment and maintenance: docs/operations/minimax-h3-gateway-manual.md
PLOTLOOM_ENABLE_H3_GATEWAY=false
# VIDEO_PROVIDER=minimax_h3_gateway
# VIDEO_BASE_URL=http://100.x.y.z:8090
# VIDEO_MODEL=minimax_h3_gateway_catalog_v2
# VIDEO_MODEL_API_KEY=

# Local runtime. PORT is reserved for hosting platforms and disables fallback.
# PORT=
# PLOTLOOM_HOST=127.0.0.1
# PLOTLOOM_PORT=8775
# Production storage has two separate roots. Source checkouts default to
# `outputs/` and `data/`; installed wheels default beneath the application
# data home. Do not point them at one another.
# PLOTLOOM_OUTPUTS_DIR=outputs
# PLOTLOOM_APPLICATION_DATA_DIR=data
# PLOTLOOM_STATIC_DIR=
# Manual image handoffs are project-owned beneath each project's `runs/`
# directory. No shared exchange root is configured.
# PLOTLOOM_RUN_WORKERS=1
# PLOTLOOM_MEDIA_WORKERS=2
# PLOTLOOM_MEDIA_POLL_INTERVAL_SECONDS=2
# PLOTLOOM_MEDIA_MAX_POLL_ATTEMPTS=300
# Managed imported-still admission limits. Defaults: 8388608 bytes / 24000000 pixels.
# PLOTLOOM_MANAGED_MEDIA_MAX_IMPORT_BYTES=8388608
# PLOTLOOM_MANAGED_MEDIA_MAX_IMPORT_PIXELS=24000000
