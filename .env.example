# Plotloom server configuration.
# Copy to `.env` in this repository root. Host environment variables take
# precedence. Never commit a real API key.

# Provider credentials. Type-specific keys override the AtlasCloud fallback.
ATLASCLOUD_API_KEY=
TEXT_MODEL_API_KEY=
IMAGE_MODEL_API_KEY=
VIDEO_MODEL_API_KEY=

# Public provider selections, HTTPS API roots, and model IDs.
TEXT_PROVIDER=
TEXT_BASE_URL=
TEXT_MODEL=
IMAGE_PROVIDER=
IMAGE_BASE_URL=
IMAGE_MODEL=
VIDEO_PROVIDER=
VIDEO_BASE_URL=
VIDEO_MODEL=

# Local runtime. PORT is reserved for hosting platforms and disables fallback.
# PORT=
# PLOTLOOM_HOST=127.0.0.1
# PLOTLOOM_PORT=8775
# PLOTLOOM_DATA_DIR=
# PLOTLOOM_DATABASE_URL=
# PLOTLOOM_ARTIFACT_ROOT=
# PLOTLOOM_STATIC_DIR=
# PLOTLOOM_RUN_WORKERS=1
# PLOTLOOM_MEDIA_WORKERS=2
# PLOTLOOM_MEDIA_POLL_INTERVAL_SECONDS=2
# PLOTLOOM_MEDIA_MAX_POLL_ATTEMPTS=300
