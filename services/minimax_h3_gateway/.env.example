# Bind to Spark's Tailscale IP, not 0.0.0.0. HTTP is intentional for a private Tailnet service.
H3_BIND_ADDRESS=100.x.y.z
H3_PORT=8090
H3_API_KEY=replace-with-a-random-secret
H3_COMFY_URL=http://127.0.0.1:8188
# Private URL/image retrieval used by POST /v1/assets and /from-image. These
# bounds protect the durable queue from unavailable or unexpectedly large files.
H3_SOURCE_FETCH_CONNECT_TIMEOUT_SECONDS=5
H3_SOURCE_FETCH_READ_TIMEOUT_SECONDS=20
H3_SOURCE_FETCH_MAX_REDIRECTS=3
# One durable FIFO dispatcher is always used. The queue has no item-count cap;
# tune only how quickly its worker checks for a completed/available H3 lane.
H3_WORKER_POLL_SECONDS=0.5
# Set false only for controlled maintenance or deterministic service testing.
H3_DISPATCH_WORKER_ENABLED=true
H3_GATEWAY_DATA_HOST_DIR=/home/wjmao/services/plotloom-h3-gateway/data
H3_COMFY_INPUT_HOST_DIR=/home/wjmao/services/spark-comfyui/data/input
# The gateway moves only the exact completed H3 MP4 it owns from this mount,
# then retains the managed copy for 72 hours under H3_GATEWAY_DATA_HOST_DIR.
H3_COMFY_OUTPUT_HOST_DIR=/home/wjmao/services/spark-comfyui/data/output
