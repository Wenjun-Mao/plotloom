    { "id": "terminal", "label": "非成功终态" }
  ],
  "states": [
    { "id": "queued", "type": "start", "label": "Queued", "lane": "main", "col": 0, "step": "01", "tag": "pristine" },
    { "id": "running-stages", "type": "active", "label": "Running Stages", "lane": "main", "col": 1, "step": "02", "tag": "provider" },
    { "id": "validating", "type": "decision", "label": "Validate Candidate", "lane": "main", "col": 2, "step": "03", "tag": "gate" },
    { "id": "atomic-commit", "type": "active", "label": "Atomic Commit", "lane": "main", "col": 3, "step": "04", "tag": "canonical" },
    { "id": "succeeded", "type": "success", "label": "Succeeded", "lane": "main", "col": 4, "step": "05", "tag": "terminal" },

    { "id": "quarantined", "type": "failure", "label": "Quarantined", "lane": "recovery", "col": 0, "yOffset": -50, "tag": "recoverable" },

    { "id": "cancel-requested", "type": "waiting", "label": "Cancel Requested", "lane": "control", "col": 2, "yOffset": 50, "tag": "cooperative" },
    { "id": "restart-scan", "type": "external", "label": "Restart Recovery", "lane": "control", "col": 1, "yOffset": 50, "tag": "startup" },

    { "id": "cancelled", "type": "failure", "label": "Cancelled", "lane": "terminal", "col": 2, "yOffset": -30, "tag": "terminal" },
    { "id": "interrupted-failed", "type": "failure", "label": "Interrupted → Failed", "lane": "terminal", "col": 1, "yOffset": -30, "tag": "terminal" }
